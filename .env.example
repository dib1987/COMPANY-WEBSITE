# Copy this file to .env.local (Vercel: add as Environment Variables).
# Configure ONE or BOTH lead-notification methods. If neither is set, leads
# are just logged to the Vercel function logs (fine for first testing).

# --- Option A: forward the lead to a webhook (n8n / Make / Zapier) ---
LEAD_WEBHOOK_URL=

# --- Option B: email yourself the lead + send the auto-reply (Resend) ---
# RESEND_API_KEY powers BOTH the "new lead" email to you AND the personalized
# auto-reply to the person who submitted the form / booked a call.
RESEND_API_KEY=
LEAD_TO_EMAIL=you@yourdomain.com
# Must be on a domain you've verified in Resend. Used as the "from" address
# for both the owner notification and the auto-reply.
LEAD_FROM_EMAIL=leads@yourdomain.com

# --- Optional: Calendly booking confirmation (/api/calendly) ---
# Set this to verify Calendly webhook signatures. Leave blank to skip
# verification (development only — set it before going live).
CALENDLY_WEBHOOK_SIGNING_KEY=
